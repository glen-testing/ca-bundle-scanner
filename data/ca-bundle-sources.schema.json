{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ca-bundle-tracker/data/ca-bundle-sources.schema.json",
  "title": "CA bundle tracker data",
  "description": "Which software ships its own Certificate Authority (CA) bundle and which delegates to the operating system (OS) trust store. Empty-value convention: every property is always present; text that does not apply is null (never an empty string, never \"N/A\"); a list with nothing in it is [] only where minItems allows it. Inline code is marked with backticks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "metadata", "sections", "entries"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "metadata": {"$ref": "#/$defs/metadata"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "text": {"type": "string", "minLength": 1},
    "optional_text": {"type": ["string", "null"], "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "retrieved"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "title": {"$ref": "#/$defs/text"},
        "retrieved": {"$ref": "#/$defs/date"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "category": {
      "enum": ["browser", "language_runtime", "cli_tool", "server", "desktop", "operating_system", "container", "embedded"]
    },
    "trust_source": {
      "description": "bundled = ships its own roots; os = uses the OS store (or is the OS store); fallback = OS first, own roots only when the OS has none; hybrid = own store plus OS-added roots; configured = no default roots, only the CA file the operator configures.",
      "enum": ["bundled", "os", "fallback", "hybrid", "configured"]
    },
    "platform": {
      "enum": ["windows", "macos", "linux", "android", "ios", "chromeos", "freebsd", "embedded"]
    },
    "revocation_channel": {
      "description": "Out-of-band channel that can block an intermediate without a software release.",
      "enum": ["OneCRL", "CRLSet", "Apple configuration data", "Windows disallowed CTL", "Google Play services", "Inherits from OS", "none"]
    },
    "glossary_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "definition"],
      "properties": {
        "term": {"$ref": "#/$defs/text"},
        "definition": {"$ref": "#/$defs/text"}
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "heading", "paragraphs", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "heading": {"$ref": "#/$defs/text"},
        "paragraphs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "sources": {"$ref": "#/$defs/sources"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "updated", "incident", "notices", "glossary"],
      "properties": {
        "title": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "updated": {"$ref": "#/$defs/date"},
        "incident": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "compromised_keys", "tls_keys", "code_signing_keys", "ca_certificates", "summary", "sources"],
          "properties": {
            "name": {"$ref": "#/$defs/text"},
            "compromised_keys": {"type": "integer", "minimum": 1},
            "tls_keys": {"type": "integer", "minimum": 0},
            "code_signing_keys": {"type": "integer", "minimum": 0},
            "ca_certificates": {"type": "integer", "minimum": 1},
            "summary": {"$ref": "#/$defs/text"},
            "sources": {"$ref": "#/$defs/sources"}
          }
        },
        "notices": {"type": "array", "items": {"$ref": "#/$defs/notice"}},
        "glossary": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/glossary_item"}}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "title", "caption"],
      "properties": {
        "category": {"$ref": "#/$defs/category"},
        "title": {"$ref": "#/$defs/text"},
        "caption": {"$ref": "#/$defs/text"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "category", "trust_source", "platforms", "bundle_origin", "location",
        "update_mechanism", "override", "revocation_channel", "remediation", "version_notes",
        "notes", "verified", "unverified_note", "sources", "last_verified"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "name": {"$ref": "#/$defs/text"},
        "category": {"$ref": "#/$defs/category"},
        "trust_source": {"$ref": "#/$defs/trust_source"},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/platform"}},
        "bundle_origin": {"$ref": "#/$defs/optional_text"},
        "location": {"$ref": "#/$defs/optional_text"},
        "update_mechanism": {"$ref": "#/$defs/text"},
        "override": {"$ref": "#/$defs/optional_text"},
        "revocation_channel": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/revocation_channel"}},
        "remediation": {"$ref": "#/$defs/text"},
        "version_notes": {"$ref": "#/$defs/optional_text"},
        "notes": {"$ref": "#/$defs/optional_text"},
        "verified": {"type": "boolean"},
        "unverified_note": {"$ref": "#/$defs/optional_text"},
        "sources": {"$ref": "#/$defs/sources"},
        "last_verified": {"$ref": "#/$defs/date"}
      },
      "if": {"properties": {"verified": {"const": false}}},
      "then": {"properties": {"unverified_note": {"type": "string"}}},
      "else": {"properties": {"unverified_note": {"type": "null"}}}
    }
  }
}
